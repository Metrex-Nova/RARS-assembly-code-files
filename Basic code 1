Write a RISC-V program (RARS) that stores an integer (20), a string ("Hii"), and a float (3.14) in the data section, prints each on its own line using the appropriate syscalls, and then exits.

data
int: .word 20
msg: .string "Hii"
newline: .string "\n"
float: .float 3.14

.text
.globl main
main:
	la t0, int
	lw a0, 0(t0)
	li a7, 1
	ecall
	
	la a0, newline
	li a7, 4
	ecall
	
	la a0, msg
	li a7, 4
	ecall
	
	la a0, newline
	li a7, 4
	ecall
	
	la t0, float
	flw fa0, 0(t0)
	li a7, 2
	ecall
	
	la a0, newline
	li a7, 4
	ecall
	
	li a7, 10
	ecall
