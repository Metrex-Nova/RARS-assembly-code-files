Write a RISC-V program (RARS) that stores an integer (20), a string ("Hii"), and a float (3.14) in the data section, prints each on its own line using the appropriate syscalls, and then exits.

data
int: .word 20
msg: .string "Hii"
newline: .string "\n"
float: .float 3.14

.text
.globl main
main:
	la t0, int
	lw a0, 0(t0)
	li a7, 1
	ecall
	
	la a0, newline
	li a7, 4
	ecall
	
	la a0, msg
	li a7, 4
	ecall
	
	la a0, newline
	li a7, 4
	ecall
	
	la t0, float
	flw fa0, 0(t0)
	li a7, 2
	ecall
	
	la a0, newline
	li a7, 4



Write a RISC-V program (RARS)  that compare 2 integers.
.data 
int_1: .word 10
int_2: .word 20
newline: .string "\n"
msg1: .string "int1 is greater than int2"
msg2: .string "int1 is equal to int2"
msg3: .string "int1 is less than int2"
.text
.globl main
main:
	la t0, int_1
	lw s0, 0(t0)
	
	la t1, int_2
	lw s1, 0(t1)
	
	beq s0, s1, equal
	blt s0, s1, less
	la a0, msg1
	j print
equal:
	la a0, msg2
	j print
less:
	la a0, msg3
print:
	li a7, 4
	ecall
	
	li a7, 10
	ecall


Q) compare 2 float values

.data 
float_1: .float 10
float_2: .float 20
newline: .string "\n"
msg1: .string "float1 is greater than float2"
msg2: .string "float1 is equal to float2"
msg3: .string "float1 is less than float2"
.text
.globl main
main:
	la t0, float_1
	flw fs0, 0(t0)
	
	la t1, float_2
	flw fs1, 0(t1)
	
	li, s2, 1
	feq.s t2, fs0, fs1
	beq t2, s2, equal
	flt.s t3, fs0, fs1
	beq t3, s2, less
	la a0, msg1
	j print
equal:
	la a0, msg2
	j print
less:
	la a0, msg3
print:
	li a7, 4
	ecall
	
	li a7, 10
	ecall
	ecall
	
	li a7, 10
	ecall
